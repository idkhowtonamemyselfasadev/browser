__pycache__/
*.pyc

# Nothing personal belongs in here — user data lives in
# ~/.local/share/browser/ (%LOCALAPPDATA%\browser\ on Windows), well
# outside the repository. These are a safety net in case a config, a
# vault or a service-account token is ever copied in by hand.
config.json
history.json
downloads.json
bookmarks.json
passwords.json
passwords.key
passwords-meta.json
privacy.json
hosts.json
cookies.txt
tabs.txt
crash.log
edit.txt
# 1password-token matches neither *.token nor *token.txt -- the name has
# no dot and does not end in "token.txt". It needs its own line.
1password-token
*.token
*token.txt
.env
.env.*

# agent worktrees and session files - never part of the browser
.claude/
CLAUDE.md

# compiled artifact of ~/claude/web-engine — built, not committed
web_engine.so

# raw screenshot output from _gallery.py - the picked and scaled ones
# live in screenshots/
.shots-in/

# built packages and the local package repositories they are served
# from. 57 MB of .deb and .rpm, rebuilt from the tree by
# packaging/make-*.sh, plus the repo metadata; none of it belongs in
# git. packaging/repo also carries a repository address that names the
# machine it is served from, so this keeps a `git add -A` from even
# offering it. The scripts themselves are NOT ignored: they are worth
# committing, and they still hold the home path, that address and the
# owner's name, so they need a placeholder pass before they can be
# (sweep: 15 occurrences over 6 files, 2026-11-02).
packaging/dist/
packaging/repo/
packaging/aptrepo/
